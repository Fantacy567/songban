  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewSession": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "default": "新讨论"
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "NewSession"
      },
      "Share": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          },
          "message_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Message Id"
          },
          "team_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Team Id"
          },
          "summary": {
            "type": "string",
            "maxLength": 3500,
            "minLength": 1,
            "title": "Summary"
          },
          "selected": {
            "type": "boolean",
            "title": "Selected"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "message_id",
          "team_id",
          "summary",
          "selected"
        ],
        "title": "Share"
      },
      "Turn": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          },
          "role_id": {
            "type": "string",
            "enum": [
              "materials",
              "direction",
              "next_step"
            ],
            "title": "Role Id"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Source Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "text",
          "role_id"
        ],
        "title": "Turn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
