  "components": {
    "schemas": {
      "Draft": {
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Goal"
          },
          "decisions": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 12,
            "title": "Decisions"
          },
          "open_questions": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 12,
            "title": "Open Questions"
          },
          "risks": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 12,
            "title": "Risks"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskDraft"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Tasks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "goal",
          "tasks"
        ],
        "title": "Draft"
      },
      "DraftUpdate": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "content": {
            "$ref": "#/components/schemas/Draft"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "content"
        ],
        "title": "DraftUpdate"
      },
      "Evidence": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Source Id"
          },
          "quote": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "quote"
        ],
        "title": "Evidence"
      },
      "GenerateInput": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "local_rules",
              "model"
            ],
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "GenerateInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemberInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Role"
          },
          "skills": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Skills"
          },
          "available_hours": {
            "type": "number",
            "maximum": 168.0,
            "exclusiveMinimum": 0.0,
            "title": "Available Hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "role",
          "skills",
          "available_hours"
        ],
        "title": "MemberInput"
      },
      "ModelDiscovery": {
        "properties": {
          "base_url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Base Url"
          },
          "api_key": {
            "type": "string",
            "format": "password",
            "title": "Api Key",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_url",
          "api_key"
        ],
        "title": "ModelDiscovery"
      },
      "ModelSelection": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "builtin",
              "custom"
            ],
            "title": "Mode"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "discovery_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Discovery Id"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode",
          "expected_version"
        ],
        "title": "ModelSelection"
      },
      "ProjectInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "title": "Deadline"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/MemberInput"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 2,
            "title": "Members"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "deadline",
          "members"
        ],
        "title": "ProjectInput"
      },
      "SourceInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "rules",
              "discussion"
            ],
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "title",
          "body"
        ],
        "title": "SourceInput"
      },
      "TaskAction": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "start",
              "block",
              "resume",
              "submit",
              "accept",
              "return"
            ],
            "title": "Action"
          },
          "note": {
            "type": "string",
            "maxLength": 5000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "action"
        ],
        "title": "TaskAction"
      },
      "TaskDraft": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,19}$",
            "title": "Key"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "owner_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Owner Id"
          },
          "acceptance": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Acceptance"
          },
          "estimated_hours": {
            "type": "number",
            "maximum": 48.0,
            "exclusiveMinimum": 0.0,
            "title": "Estimated Hours"
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should"
            ],
            "title": "Priority"
          },
          "due_at": {
            "type": "string",
            "format": "date-time",
            "title": "Due At"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Depends On"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "title",
          "owner_id",
          "acceptance",
          "estimated_hours",
          "priority",
          "due_at",
          "evidence"
        ],
        "title": "TaskDraft"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
