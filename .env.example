# 复制为 .env；该文件被 Git 忽略。不填写时仍可使用明确标注的规则演练。
# 内置 DeepSeek-V4-Pro（deepseek-v4-pro），官方服务 https://api.deepseek.com。
DEEPSEEK_API_KEY=
# 以下三项是服务端自定义默认模型的兼容配置；DEEPSEEK_API_KEY 非空时优先使用官方预设。
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# 用户自带密钥仅可发送给明确允许的 HTTPS 服务；其他服务由部署者追加域名。
MODEL_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,dashscope.aliyuncs.com,open.bigmodel.cn,openrouter.ai
# 本机默认无需 CORS；胡另起前端时填写他实际使用的 Origin，逗号分隔。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 默认 data/collab.sqlite3。可覆盖为持久化磁盘上的绝对路径。
DATABASE_PATH=
# 邀请链接和微信回调使用的对外地址。微信要求 https 的已备案域名，127.0.0.1 不行。
PUBLIC_BASE_URL=
# 微信开放平台里审核通过的网站应用。没有这两项时，微信按钮不会放人进去。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 设为 1 时，获取验证码会试着用这台 Mac 的「信息」发给对方。发不出去就仍显示在页面上。
SONGBAI_IMESSAGE=
