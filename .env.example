# 默认只开放核心团队协作；设为0仅用于维护保留页面。
SONGBAN_CORE_ONLY=1
# 复制为 .env；该文件被 Git 忽略。不填写时仍可使用明确标注的规则演练。
# 内置 DeepSeek-V4.1-Flash（deepseek-flash），官方服务 https://api.deepseek.com。
DEEPSEEK_API_KEY=
# 以下三项是服务端自定义默认模型的兼容配置；DEEPSEEK_API_KEY 非空时优先使用官方预设。
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# 团队空间默认使用上面的 DEEPSEEK_API_KEY。只有要换别的服务时才填下面三项。密钥不要提交。
TEAM_MODEL_API_KEY=
TEAM_MODEL_BASE_URL=
TEAM_MODEL_NAME=
# 用户自带密钥仅可发送给明确允许的 HTTPS 服务；其他服务由部署者追加域名。
MODEL_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,dashscope.aliyuncs.com,open.bigmodel.cn,openrouter.ai
# 本机默认无需 CORS；胡另起前端时填写他实际使用的 Origin，逗号分隔。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 默认 data/collab.sqlite3。可覆盖为持久化磁盘上的绝对路径。
DATABASE_PATH=
# 邀请链接和微信回调使用的对外地址。必须是你已备案、并在微信开放平台「授权回调域」里填过的 https 域名。
# trycloudflare / ngrok 临时隧道不能作为微信回调域。
PUBLIC_BASE_URL=https://你的备案域名
# 微信开放平台 → 网站应用 的 AppID / AppSecret。不要提交真实密钥到 Git。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 个人账号请用「号码认证 → 短信认证」的赠送签名和模板，不要走企业资质短信服务。
# 控制台：https://dypns.console.aliyun.com
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 只有企业资质短信服务才写成 enterprise。个人短信认证请留空。
ALIYUN_SMS_MODE=pnvs
# 默认没有短信通道就拒绝注册/重置。设为 1 可进一步强制必须成功发送。
SONGBAI_REQUIRE_SMS=
# 仅限隔离的本机开发：设为 1 才会把未发送的测试验证码返回页面。公网严禁开启。
SONGBAI_ALLOW_TEST_CODES=
# 本机「信息」转发，只作备用。
SONGBAI_IMESSAGE=
SONGBAI_SMS=
